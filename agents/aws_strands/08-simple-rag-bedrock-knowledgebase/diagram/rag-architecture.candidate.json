  "cards": [
    {
      "dot": "violet",
      "title": "Ingestion order (I)",
      "items": [
        "I1 Streamlit uploads files to S3",
        "I2 Sync button calls start_ingestion_job; KB reads S3 and splits fixed-size chunks",
        "I3 each chunk embedded by Titan v2 (1024-d)",
        "I4 vector + text written to the OpenSearch index"
      ]
    },
    {
      "dot": "cyan",
      "title": "Query order (Q)",
      "items": [
        "Q1 question enters the KB (simple) or the agent's retrieve tool (agentic)",
        "Q2 question embedded with the same model",
        "Q3 k-NN search returns 20 candidates",
        "Q4 reranker keeps the best 5",
        "Q5 LLM answers from those 5 chunks"
      ]
    },
    {
      "dot": "rose",
      "title": "IAM roles",
      "items": [
        "KB service role: S3 read, embed + rerank invoke, aoss:APIAccessAll",
        "Agent execution role: InvokeModel, bedrock:Retrieve, ECR pull, logs, X-Ray"
      ]
    }
  ]
