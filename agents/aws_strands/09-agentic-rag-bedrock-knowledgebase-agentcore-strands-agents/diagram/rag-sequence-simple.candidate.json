  "cards": [
    {
      "dot": "violet",
      "title": "Ingestion first",
      "items": [
        "Documents are embedded once, at sync time",
        "Queries embed only the question"
      ]
    },
    {
      "dot": "amber",
      "title": "Reranking inside retrieval",
      "items": [
        "Vector search over-fetches 20, the reranker keeps 5",
        "Skipped when RERANK_MODEL_ARN is empty"
      ]
    },
    {
      "dot": "cyan",
      "title": "One call does it all",
      "items": [
        "retrieve_and_generate runs embed, search, rerank and generation inside the KB",
        "Streamlit only sends the question and shows the answer"
      ]
    }
