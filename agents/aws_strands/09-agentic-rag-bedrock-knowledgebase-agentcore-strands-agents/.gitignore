# --- Secrets & environment ---------------------------------------------------
# app/.env and agent/.env are generated by `terraform apply` (account IDs, ARNs).
.env
.env.*
*.env
!.env_example
!.env.example
.envrc

# Credentials, keys and certificates
.aws/
credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*
*secret*
*secrets*
!*secret*.md

# --- Terraform ----------------------------------------------------------------
# State files contain resource details and can contain secrets in plain text.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
# Keep .terraform.lock.hcl tracked (pins provider versions).

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Tools & local settings ---------------------------------------------------
.claude/settings.local.json
.archify/
.streamlit/secrets.toml
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
