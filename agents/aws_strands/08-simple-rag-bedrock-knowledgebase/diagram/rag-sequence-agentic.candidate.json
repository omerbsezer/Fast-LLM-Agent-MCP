  "cards": [
    {
      "dot": "violet",
      "title": "Ingestion first",
      "items": [
        "Documents are embedded once, at sync time",
        "Queries embed only the question"
      ]
    },
    {
      "dot": "amber",
      "title": "Reranking inside retrieval",
      "items": [
        "Vector search over-fetches 20, the reranker keeps 5",
        "Skipped when RERANK_MODEL_ARN is empty"
      ]
    },
    {
      "dot": "emerald",
      "title": "The agent owns generation",
      "items": [
        "retrieve returns chunks only; the agent calls the LLM",
        "The LLM decides how often to loop; the code caps it at 3 retrievals",
        "Runs on AgentCore only when Compare is ticked"
      ]
    }
  ]
