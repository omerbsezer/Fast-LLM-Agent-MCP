# Writes the Terraform outputs the app and the local agent need into their
# .env files, so `python app.py` works right after `terraform apply` with no
# manual copying. Re-generated on every apply (e.g. after ../deploy.sh sets
# AGENT_RUNTIME_ARN).

locals {
  agent_runtime_arn = try(aws_bedrockagentcore_agent_runtime.agent[0].agent_runtime_arn, "")
}

resource "local_file" "app_env" {
  filename        = "${path.module}/../app/.env"
  file_permission = "0600"
  content         = <<-EOT
    # Generated by Terraform (terraform/app_config.tf). Do not edit: changes are overwritten on apply.
    AWS_REGION=${var.aws_region}
    DOCS_BUCKET_NAME=${aws_s3_bucket.docs.bucket}
    KNOWLEDGE_BASE_ID=${aws_bedrockagent_knowledge_base.this.id}
    DATA_SOURCE_ID=${aws_bedrockagent_data_source.docs.data_source_id}
    GENERATION_MODEL_ARN=${local.generation_model_arn}
    RERANK_MODEL_ARN=${var.enable_reranking ? local.rerank_model_arn : ""}
    AGENT_RUNTIME_ARN=${local.agent_runtime_arn}
  EOT
}

# Only used for the local dev loop (python3 agent.py "question"); the deployed
# AgentCore Runtime gets its environment from agentcore.tf instead.
resource "local_file" "agent_env" {
  filename        = "${path.module}/../agent/.env"
  file_permission = "0600"
  content         = <<-EOT
    # Generated by Terraform (terraform/app_config.tf). Do not edit: changes are overwritten on apply.
    AWS_REGION=${var.aws_region}
    KNOWLEDGE_BASE_ID=${aws_bedrockagent_knowledge_base.this.id}
    GENERATION_MODEL_ID=${var.generation_model_id}
    RERANK_MODEL_ARN=${var.enable_reranking ? local.rerank_model_arn : ""}
  EOT
}
